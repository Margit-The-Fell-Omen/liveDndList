        "FEY",
        "CONSTRUCT",
        "UNDEAD",
        "DRAGON",
        "CELESTIAL",
        "FIEND",
        "ELEMENTAL",
        "GIANT",
        "MONSTROSITY",
        "BEAST",
        "OOZE",
        "PLANT",
        "ABERRATION"
      ]
