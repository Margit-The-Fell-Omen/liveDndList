    {
      "key": "srd-2024_sorcerer_innate-sorcery",
      "name": "Innate Sorcery",
      "description": "As a Bonus Action, you can unleash your innate magic for 1 minute, gaining:\n\n- Spell save DC of your Sorcerer spells increases by 1\n- Advantage on the attack rolls of Sorcerer spells you cast\n\nYou can use this feature twice, and you regain all expended uses when you finish a Long Rest.",
      "gainedAtLevel": 1,
      "displayOrder": 1,
      "effects": [
        {
          "type": "GRANT_RESOURCE",
          "payload": {
            "resourceKey": "innate_sorcery",
            "displayName": "Innate Sorcery",
            "usesFormula": {
              "base": 2
            },
            "refresh": "LONG"
          }
        },
        {
          "type": "GRANT_BONUS_ACTION",
          "payload": {
            "name": "Innate Sorcery",
            "description": "Activate for 1 minute: +1 spell save DC, Advantage on Sorcerer spell attack rolls.",
            "resourceKey": "innate_sorcery"
          }
        }
      ]
    },
    {
      "key": "srd-2024_sorcerer_spellcasting",
      "name": "Spellcasting",
      "description": "Drawing from your innate magic, you can cast spells. Charisma is your spellcasting ability.\n\n**Spell save DC** = 8 + your proficiency bonus + your Charisma modifier\n**Spell attack modifier** = your proficiency bonus + your Charisma modifier\n\n**Cantrips:** 4 (L1), 5 (L4), 6 (L10). Chosen from the Sorcerer spell list.\n**Prepared Spells:** Fixed by class table. Starting at 2 at L1, scaling to 22 at L20.\n\nYou can use an Arcane Focus as a Spellcasting Focus.",
      "gainedAtLevel": 1,
      "displayOrder": 2,
      "effects": [
