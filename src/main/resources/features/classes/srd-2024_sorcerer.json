    {
      "key": "srd-2024_sorcerer_font-of-magic",
      "name": "Font of Magic",
      "description": "You can tap into the wellspring of magic within yourself. This wellspring is represented by Sorcery Points equal to your Sorcerer level. Regain all on Long Rest.\n\n**Converting Spell Slots to Sorcery Points.** Expend a spell slot to gain SP equal to slot's level (no action).\n\n**Creating Spell Slots.** As a Bonus Action, spend SP to create a spell slot (max level 5): 1st=2 SP, 2nd=3, 3rd=5, 4th=6, 5th=7. Slot vanishes on Long Rest.",
      "gainedAtLevel": 2,
      "displayOrder": 3,
      "effects": [
        {
          "type": "GRANT_RESOURCE",
          "payload": {
            "resourceKey": "sorcery_points",
            "displayName": "Sorcery Points",
            "usesFormula": {
              "classLevel": true
            },
            "refresh": "LONG"
          }
        },
        {
          "type": "GRANT_BONUS_ACTION",
          "payload": {
            "name": "Flexible Casting",
            "description": "Convert SP into spell slots (up to 5th, cost 2/3/5/6/7) or convert a spell slot into SP equal to slot level.",
            "resourceKey": "sorcery_points"
          }
        }
      ]
    },
    {
      "key": "srd-2024_sorcerer_metamagic",
      "name": "Metamagic",
      "description": "You gain two Metamagic options of your choice from the Metamagic Options list: Careful, Distant, Empowered, Extended, Heightened, Quickened, Seeking, Subtle, Transmuted, or Twinned Spell.\n\nYou can use only one Metamagic option per spell cast unless otherwise noted. Whenever you gain a Sorcerer level, you can replace one option.\n\nYou gain two more options at Sorcerer level 10 and two more at level 17.",
      "gainedAtLevel": 2,
      "displayOrder": 4,
