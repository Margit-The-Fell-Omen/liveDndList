    {
      "key": "srd_sorcerer_sorcerous-origin",
      "name": "Sorcerous Origin",
      "description": "Choose a sorcerous origin, which describes the source of your innate magical power: Draconic Bloodline or Wild Magic. Your choice grants you features when you choose it at 1st level and again at 6th, 14th, and 18th level.",
      "gainedAtLevel": 1,
      "displayOrder": 2,
      "effects": [
        {
          "type": "NARRATIVE_ONLY",
          "payload": {}
        }
      ]
    },
    {
      "key": "srd_sorcerer_font-of-magic",
      "name": "Font of Magic",
      "description": "At 2nd level, you tap into a deep wellspring of magic within yourself, represented by sorcery points. You have a number of sorcery points equal to your sorcerer level (max 20). Regain all spent points on a long rest.\n\n**Flexible Casting:** As a bonus action, you can transform sorcery points into spell slots (up to 5th level) or convert a spell slot into sorcery points equal to its level.\n\nSpell slot creation costs: 1st = 2 pts, 2nd = 3 pts, 3rd = 5 pts, 4th = 6 pts, 5th = 7 pts. Slots created this way vanish on a long rest.",
      "gainedAtLevel": 2,
      "displayOrder": 3,
      "effects": [
        {
          "type": "GRANT_RESOURCE",
          "payload": {
            "resourceKey": "sorcery_points",
            "displayName": "Sorcery Points",
            "usesFormula": {
              "classLevel": true
            },
            "refresh": "LONG"
          }
        },
        {
          "type": "GRANT_BONUS_ACTION",
          "payload": {
            "name": "Flexible Casting",
            "description": "Convert sorcery points into spell slots (up to 5th, cost 2/3/5/6/7) or convert a spell slot into sorcery points equal to slot level.",
            "resourceKey": "sorcery_points"
          }
        }
      ]
    },
    {
      "key": "srd_sorcerer_metamagic",
      "name": "Metamagic (Level 3)",
      "description": "At 3rd level, you gain the ability to twist your spells to suit your needs. You gain two Metamagic options of your choice: Careful Spell, Distant Spell, Empowered Spell, Extended Spell, Heightened Spell, Quickened Spell, Subtle Spell, or Twinned Spell.\n\nYou can use only one Metamagic option on a spell when you cast it, unless otherwise noted.",
      "gainedAtLevel": 3,
      "displayOrder": 4,
