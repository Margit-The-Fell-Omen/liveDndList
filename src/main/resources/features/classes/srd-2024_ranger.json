    {
      "key": "srd-2024_ranger_favored-enemy",
      "name": "Favored Enemy",
      "description": "You always have the *Hunter's Mark* spell prepared. You can cast it without expending a spell slot a number of times equal to your proficiency-scaling uses (2 at L1, 3 at L5, 4 at L9, 5 at L13, 6 at L17). You regain all expended uses on a Long Rest.",
      "gainedAtLevel": 1,
      "displayOrder": 1,
      "effects": [
        {
          "type": "GRANT_RESOURCE",
          "payload": {
            "resourceKey": "free_hunters_mark",
            "displayName": "Free Hunter's Mark",
            "usesFormula": {
              "perClassLevel": {
                "1": 2,
                "5": 3,
                "9": 4,
                "13": 5,
                "17": 6
              }
            },
            "refresh": "LONG"
          }
        }
      ]
    },
    {
      "key": "srd-2024_ranger_spellcasting",
      "name": "Spellcasting",
      "description": "You have learned to channel the magical essence of nature to cast spells. Wisdom is your spellcasting ability.\n\n**Spell save DC** = 8 + your proficiency bonus + your Wisdom modifier\n**Spell attack modifier** = your proficiency bonus + your Wisdom modifier\n\n**Prepared Spells:** Fixed by class table. Starting at 2 at L1, scaling to 15 at L20. Chosen from the Ranger spell list. Changed after each Long Rest.\n\nYou can use a Druidic Focus as a Spellcasting Focus.",
      "gainedAtLevel": 1,
      "displayOrder": 2,
      "effects": [
        {
          "type": "GRANT_SPELLCASTING",
          "payload": {
            "ability": "WIS",
            "casterType": "HALF",
            "spellList": "ranger",
            "ritualCasting": false,
            "spellbook": false
