### Create Equipment - Longsword
POST {{baseUrl}}/equipment
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Longsword",
  "type": "WEAPON",
  "damage": "1d8",
  "damageType": "slashing",
  "properties": "Versatile (1d10)",
  "weight": 3.0,
  "description": "A standard longsword",
  "quantity": 1,
  "equipped": false
}

> {%
  if (response.status === 201 && response.body && response.body.data) {
    client.global.set("equipmentId", response.body.data.id);
    client.log(
        "✓ Equipment created: " + response.body.data.name + " (ID: " + response.body.data.id + ")");
  }
%}

