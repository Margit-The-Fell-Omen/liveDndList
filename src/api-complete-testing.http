### Add equipment to character
POST {{baseUrl}}/characters/{{characterId}}/equipment
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Shortsword",
  "type": "WEAPON",
  "damage": "1d6",
  "damageType": "piercing",
  "properties": "Finesse, Light",
  "weight": 2.0,
  "equipped": true,
  "quantity": 1
}

> {%
  if (response.status === 200) {
    client.log("✓ Equipment added to character");
  }
%}

### Add spell to character
POST {{baseUrl}}/characters/{{characterId}}/spells/{{spellId}}
Authorization: Bearer {{authToken}}

> {%
  if (response.status === 200) {
    client.log("✓ Spell added to character");
  }
%}

### Remove spell from character
DELETE {{baseUrl}}/characters/{{characterId}}/spells/{{spellId}}
Authorization: Bearer {{authToken}}

> {%
  if (response.status === 200) {
    client.log("✓ Spell removed from character");
  }
%}

