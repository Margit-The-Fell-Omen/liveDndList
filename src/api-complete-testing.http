### ============================================
### ENVIRONMENT VARIABLES
### ============================================

@baseUrl = http://localhost:8080/api/v1
@authToken =
@userId =
@characterId =
@spellId =
@equipmentId =

### Register User 1 (main test user)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@example.com",
  "password": "Password123!"
}

> {%
  if (response.status === 201 && response.body && response.body.data) {
    client.global.set("userId", response.body.data.id);
    client.log("✓ User registered with ID: " + response.body.data.id);
  } else {
    client.log("Registration response: " + response.status);
  }
%}

### Register User 2 (for testing search)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "gandalf",
  "email": "gandalf@middleearth.com",
  "password": "YouShallNotPass123!"
}

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "Password123!"
}

> {%
  if (response.status === 200 && response.body && response.body.data && response.body.data.token) {
    client.global.set("authToken", response.body.data.token);
    client.log("✓ Logged in successfully");
    client.log("Token: " + response.body.data.token);
  } else {
    client.log("Login failed with status: " + response.status);
  }
%}

### Login with invalid credentials (error test)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "wrongpassword"
}

> {%
  if (response.status === 401 || response.status === 403) {
    client.log("✓ Correctly rejected invalid credentials");
  } else {
    client.log("Unexpected status: " + response.status);
  }
%}

### Get current user profile
GET {{baseUrl}}/users/me
Authorization: Bearer {{authToken}}

> {%
  if (response.status === 200 && response.body && response.body.data) {
    client.log("✓ Current user: " + response.body.data.username);
  }
%}

### Get all users
GET {{baseUrl}}/users
Authorization: Bearer {{authToken}}

> {%
  if (response.status === 200 && response.body && response.body.data) {
    client.log("✓ Retrieved " + response.body.data.length + " users");
  }
%}

