### CLEANUP (Run these last if needed)
### ============================================

### Delete test equipment
DELETE {{baseUrl}}/equipment/{{equipmentId}}
Authorization: Bearer {{authToken}}

> {%
  client.log("✓ Equipment deleted");
%}

###

### Delete test spell
DELETE {{baseUrl}}/spells/{{spellId}}
Authorization: Bearer {{authToken}}

> {%
  client.log("✓ Spell deleted");
%}

###

### Delete test character
DELETE {{baseUrl}}/characters/{{characterId}}
Authorization: Bearer {{authToken}}

> {%
  client.log("✓ Character deleted");
%}

###

### Delete test user
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{authToken}}

> {%
  client.log("✓ User deleted");
%}
