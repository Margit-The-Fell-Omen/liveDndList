### Create Character - Aragorn
POST {{baseUrl}}/characters
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Aragorn",
  "race": "HUMAN",
  "subrace": "Variant",
  "className": "RANGER",
  "subclass": "Hunter",
  "alignment": "LAWFUL_GOOD",
  "background": "Noble",
  "maxHitPoints": 12,
  "portraitUrl": "https://example.com/aragorn.jpg",
  "abilityScores": {
    "strength": 16,
    "dexterity": 14,
    "constitution": 14,
    "intelligence": 10,
    "wisdom": 13,
    "charisma": 12
  }
}

> {%
  if (response.status === 201 && response.body && response.body.data) {
    client.global.set("characterId", response.body.data.id);
    client.log(
        "✓ Character created: " + response.body.data.name + " (ID: " + response.body.data.id + ")");
  }
%}

