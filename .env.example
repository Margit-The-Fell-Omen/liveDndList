# Copy this file to `.env` and adjust the values for your environment.
# `docker compose` automatically loads `.env` for variable substitution.
#
#   cp .env.example .env

# Docker Compose project name (keeps container/volume names stable)
COMPOSE_PROJECT_NAME=livednd-dev

# PostgreSQL
POSTGRES_DB=livedndlist
POSTGRES_USER=ushki
POSTGRES_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-redis-password

# Backend JWT signing secret (long random string; e.g. `openssl rand -hex 48`)
APP_JWT_SECRET=change-me-to-a-long-random-string